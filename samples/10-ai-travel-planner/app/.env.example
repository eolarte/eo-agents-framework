# Set for both the ASP.NET Core process and Vite build/dev process. Never commit a real key.
# This shared key is included in browser code when Vite builds the map view.
GOOGLE_PLACES_API_KEY=
# Set in app/.env.local before running Vite or building the frontend.
# Optional for local testing (defaults to DEMO_MAP_ID). Use your own JavaScript map ID for deployment.
VITE_GOOGLE_MAPS_MAP_ID=
# The existing sample convention uses OpenAIClient with this legacy variable name.
# This key is sent to the OpenAI API, not to an Azure OpenAI endpoint.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_NAME=
